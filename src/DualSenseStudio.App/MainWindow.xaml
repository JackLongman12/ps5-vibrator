<Window x:Class="DualSenseStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DualSenseStudio.Controls"
        Title="DualSense Studio" Width="1240" Height="820" MinWidth="980" MinHeight="640"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,16,18">
                    <TextBlock Text="DualSense Studio" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Text="dev build" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="12" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnText" Text="No controller" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnDetail" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Connect a DualSense by USB or Bluetooth."/>
                        <ProgressBar x:Name="BatteryBar" Style="{StaticResource Meter}" Margin="0,8,0,0" Height="5" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Nav">
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="presets" Content="Presets" Checked="OnNav" IsChecked="True"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="recorder" Content="Recorder" Checked="OnNav"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="library" Content="My Patterns" Checked="OnNav"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="triggers" Content="Trigger Lab" Checked="OnNav"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="live" Content="Live Play" Checked="OnNav"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="lights" Content="Lights" Checked="OnNav"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="monitor" Content="Input Monitor" Checked="OnNav"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="settings" Content="Settings &amp; Updates" Checked="OnNav"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Banners -->
            <StackPanel Grid.Row="0">
                <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#1C2A4A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                    <DockPanel>
                        <Button x:Name="UpdateAction" DockPanel.Dock="Right" Style="{StaticResource SolidButton}" Margin="0" Padding="14,6" Click="OnUpdateAction"/>
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border x:Name="WarnBanner" Visibility="Collapsed" Background="#33291A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource GhostButton}" Margin="0" Click="OnDismissWarn"/>
                        <TextBlock x:Name="WarnText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <ContentControl x:Name="Page" Grid.Row="1"/>

            <!-- Now playing -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource Muted}" FontSize="10.5"/>
                        <TextBlock x:Name="NowName" Text="Nothing" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <c:PatternView x:Name="NowView" Grid.Column="1" Height="44" Compact="True" ShowGrid="False" Margin="0,0,16,0"/>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Intensity" Style="{StaticResource Label}"/>
                        <Slider x:Name="IntensitySlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="OnIntensity" Margin="0,0,16,0"/>
                        <TextBlock Text="Speed" Grid.Column="2" Style="{StaticResource Label}"/>
                        <Slider x:Name="SpeedSlider" Grid.Column="3" Minimum="-2" Maximum="2" ValueChanged="OnSpeed" ToolTip="0.25× – 4×"/>
                        <TextBlock Text="Balance" Grid.Row="1" Style="{StaticResource Label}"/>
                        <Slider x:Name="BalanceSlider" Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" ValueChanged="OnBalance" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SpeedText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Text="1.00×"/>
                        <CheckBox x:Name="TriggerToggle" Grid.Row="1" Grid.Column="3" Content="Trigger vibes" ToolTip="Play the pattern's trigger vibration channels" Click="OnTriggerToggle" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="3" Width="70" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="L" Style="{StaticResource Muted}" FontSize="10"/>
                        <ProgressBar x:Name="OutL" Style="{StaticResource Meter}" Foreground="{StaticResource LeftChannelBrush}"/>
                        <TextBlock Text="R" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="OutR" Style="{StaticResource Meter}" Foreground="{StaticResource RightChannelBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="■  STOP" Style="{StaticResource DangerButton}" Padding="22,12" Margin="0" Click="OnStop"
                            ToolTip="Stop everything (Ctrl+Alt+S anywhere, or the controller's mute button)"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
