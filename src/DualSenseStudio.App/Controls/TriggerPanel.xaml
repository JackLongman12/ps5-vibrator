<UserControl x:Class="DualSenseStudio.Controls.TriggerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="Title" Text="L2" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                <ProgressBar x:Name="PressMeter" Style="{StaticResource Meter}" Width="140" HorizontalAlignment="Right" ToolTip="Current trigger position"/>
            </DockPanel>
            <WrapPanel x:Name="ModeChips">
                <RadioButton Style="{StaticResource Chip}" Content="Off" Tag="Off" Checked="OnMode" IsChecked="True"/>
                <RadioButton Style="{StaticResource Chip}" Content="Resistance" Tag="Resistance" Checked="OnMode"/>
                <RadioButton Style="{StaticResource Chip}" Content="Slope" Tag="Slope" Checked="OnMode"/>
                <RadioButton Style="{StaticResource Chip}" Content="Click / break" Tag="Weapon" Checked="OnMode"/>
                <RadioButton Style="{StaticResource Chip}" Content="Vibration" Tag="Vibration" Checked="OnMode"/>
            </WrapPanel>
            <TextBlock x:Name="ModeHelp" Style="{StaticResource Muted}" Margin="0,2,0,10" MinHeight="32"/>

            <DockPanel x:Name="StartRow"><TextBlock Text="Start zone" Style="{StaticResource Label}" Width="90"/><TextBlock x:Name="StartText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"/><Slider x:Name="StartSlider" Minimum="0" Maximum="9" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnValue"/></DockPanel>
            <DockPanel x:Name="EndRow"><TextBlock Text="End zone" Style="{StaticResource Label}" Width="90"/><TextBlock x:Name="EndText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"/><Slider x:Name="EndSlider" Minimum="1" Maximum="9" Value="9" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnValue"/></DockPanel>
            <DockPanel x:Name="StrengthRow"><TextBlock x:Name="StrengthLabel" Text="Strength" Style="{StaticResource Label}" Width="90"/><TextBlock x:Name="StrengthText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"/><Slider x:Name="StrengthSlider" Minimum="1" Maximum="8" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnValue"/></DockPanel>
            <DockPanel x:Name="EndStrengthRow"><TextBlock Text="End strength" Style="{StaticResource Label}" Width="90"/><TextBlock x:Name="EndStrengthText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"/><Slider x:Name="EndStrengthSlider" Minimum="1" Maximum="8" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnValue"/></DockPanel>
            <DockPanel x:Name="FreqRow"><TextBlock Text="Frequency" Style="{StaticResource Label}" Width="90"/><TextBlock x:Name="FreqText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"/><Slider x:Name="FreqSlider" Minimum="1" Maximum="200" Value="30" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnValue"/></DockPanel>
        </StackPanel>
    </Border>
</UserControl>
