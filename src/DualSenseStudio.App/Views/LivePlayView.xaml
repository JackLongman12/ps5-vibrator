<UserControl x:Class="DualSenseStudio.Views.LivePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,24,24">
            <TextBlock Text="Live Play" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                       Text="Drive the vibration in real time with the controller's other sensors, or with your PC's sound. Only one source plays at a time. Starting one replaces whatever is playing."/>

            <!-- Touchpad -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Touchpad pad" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Slide a finger: up/down sets strength, left/right sets texture, from smooth on the left to fast pulses on the right. With two fingers, each finger drives its own side."/>
                        <DockPanel Margin="0,12,0,0"><TextBlock Text="Gain" Style="{StaticResource Label}" Width="44"/><Slider x:Name="TouchGain" Minimum="0.1" Maximum="1" Value="1" ValueChanged="OnTouchGain"/></DockPanel>
                        <Button x:Name="TouchButton" Content="▶  Start touchpad" Style="{StaticResource SolidButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnTouch"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14171E" CornerRadius="8" Height="160" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <Canvas x:Name="TouchCanvas" ClipToBounds="True">
                            <Ellipse x:Name="Finger0" Width="22" Height="22" Fill="{StaticResource LeftChannelBrush}" Visibility="Collapsed"/>
                            <Ellipse x:Name="Finger1" Width="22" Height="22" Fill="{StaticResource RightChannelBrush}" Visibility="Collapsed"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- Motion -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Motion control" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Tilt forward or back for strength, left or right for balance. Shake for a burst. Press Calibrate while holding the controller in your neutral position."/>
                        <DockPanel Margin="0,12,0,0"><TextBlock Text="Range" Style="{StaticResource Label}" Width="44"/><TextBlock x:Name="TiltText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Muted}"/><Slider x:Name="TiltSlider" Minimum="15" Maximum="90" Value="50" ValueChanged="OnTilt"/></DockPanel>
                        <DockPanel><TextBlock Text="Gain" Style="{StaticResource Label}" Width="44"/><Slider x:Name="MotionGain" Minimum="0.1" Maximum="1" Value="1" ValueChanged="OnMotionGain"/></DockPanel>
                        <CheckBox x:Name="ShakeCheck" Content="Shake for a burst" IsChecked="True" Click="OnShake" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="MotionButton" Content="▶  Start motion" Style="{StaticResource SolidButton}" Click="OnMotion"/>
                            <Button Content="Calibrate" Style="{StaticResource GhostButton}" Click="OnCalibrate" Margin="0"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tilt forward / back" Style="{StaticResource Muted}"/>
                        <ProgressBar x:Name="PitchMeter" Style="{StaticResource Meter}" Margin="0,4,0,10"/>
                        <TextBlock Text="Tilt left / right" Style="{StaticResource Muted}"/>
                        <Slider x:Name="RollView" Minimum="-1" Maximum="1" IsEnabled="False" Margin="0,2,0,8"/>
                        <TextBlock x:Name="MotionText" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Audio -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Audio reactive" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Feel whatever your PC is playing, such as music, games or video. Bass drives the heavy left side and treble drives the light right side."/>
                        <DockPanel Margin="0,12,0,0"><TextBlock Text="Gain" Style="{StaticResource Label}" Width="54"/><Slider x:Name="AudioGain" Minimum="0.3" Maximum="5" Value="1.5" ValueChanged="OnAudioParams"/></DockPanel>
                        <DockPanel><TextBlock Text="Bass" Style="{StaticResource Label}" Width="54"/><Slider x:Name="BassWeight" Minimum="0" Maximum="1.5" Value="1" ValueChanged="OnAudioParams"/></DockPanel>
                        <DockPanel><TextBlock Text="Treble" Style="{StaticResource Label}" Width="54"/><Slider x:Name="TrebleWeight" Minimum="0" Maximum="1.5" Value="0.6" ValueChanged="OnAudioParams"/></DockPanel>
                        <Button x:Name="AudioButton" Content="▶  Start audio reactive" Style="{StaticResource SolidButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnAudio"/>
                        <TextBlock x:Name="AudioError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bass" Style="{StaticResource Muted}"/>
                        <ProgressBar x:Name="BassMeter" Style="{StaticResource Meter}" Foreground="{StaticResource LeftChannelBrush}" Margin="0,4,0,10" Height="12"/>
                        <TextBlock Text="Treble" Style="{StaticResource Muted}"/>
                        <ProgressBar x:Name="TrebleMeter" Style="{StaticResource Meter}" Foreground="{StaticResource RightChannelBrush}" Margin="0,4,0,0" Height="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
