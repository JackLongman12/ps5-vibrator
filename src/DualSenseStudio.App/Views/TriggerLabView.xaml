<UserControl x:Class="DualSenseStudio.Views.TriggerLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DualSenseStudio.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,24,24">
            <TextBlock Text="Trigger Lab" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                       Text="Shape how L2 and R2 push back. Changes apply instantly, so press the triggers to feel them. These stay active while patterns play. A pattern with trigger vibration takes over a trigger only while that vibration is playing."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Quick feels (both triggers)" Style="{StaticResource H2}"/>
                    <WrapPanel x:Name="Quick">
                        <Button Content="Off" Style="{StaticResource GhostButton}" Tag="off" Click="OnQuick"/>
                        <Button Content="Soft spring" Style="{StaticResource GhostButton}" Tag="soft" Click="OnQuick"/>
                        <Button Content="Heavy" Style="{StaticResource GhostButton}" Tag="heavy" Click="OnQuick"/>
                        <Button Content="Bow draw" Style="{StaticResource GhostButton}" Tag="bow" Click="OnQuick"/>
                        <Button Content="Brake pedal" Style="{StaticResource GhostButton}" Tag="brake" Click="OnQuick"/>
                        <Button Content="Trigger click" Style="{StaticResource GhostButton}" Tag="click" Click="OnQuick"/>
                        <Button Content="Rapid fire buzz" Style="{StaticResource GhostButton}" Tag="buzz" Click="OnQuick"/>
                        <Button Content="Deep rumble" Style="{StaticResource GhostButton}" Tag="rumble" Click="OnQuick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <c:TriggerPanel x:Name="LeftPanel" Side="L2  (left trigger)"/>
                <c:TriggerPanel x:Name="RightPanel" Grid.Column="2" Side="R2  (right trigger)"/>
            </Grid>
            <CheckBox x:Name="LinkCheck" Content="Link: edits to one trigger apply to both"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
