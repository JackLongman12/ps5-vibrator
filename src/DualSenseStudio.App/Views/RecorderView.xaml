<UserControl x:Class="DualSenseStudio.Views.RecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DualSenseStudio.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,24,24">
            <TextBlock Text="Recorder" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                       Text="Play the triggers like an instrument. What you press is recorded into a loop, and you feel it live while recording. Press Create on the controller to start or stop."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mapping -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1 · How presses become vibration" Style="{StaticResource H2}"/>
                        <WrapPanel>
                            <RadioButton GroupName="map" Style="{StaticResource Chip}" Content="Pressure" Tag="Pressure" IsChecked="True" Checked="OnMapping"/>
                            <RadioButton GroupName="map" Style="{StaticResource Chip}" Content="Dual channel" Tag="DualChannel" Checked="OnMapping"/>
                            <RadioButton GroupName="map" Style="{StaticResource Chip}" Content="Velocity accents" Tag="VelocityAccents" Checked="OnMapping"/>
                            <RadioButton GroupName="map" Style="{StaticResource Chip}" Content="Zones" Tag="Zones" Checked="OnMapping"/>
                        </WrapPanel>
                        <TextBlock x:Name="MappingHelp" Style="{StaticResource Muted}" Margin="0,4,0,10" MinHeight="34"/>
                        <DockPanel>
                            <TextBlock Text="Feel" Style="{StaticResource Label}"/>
                            <TextBlock DockPanel.Dock="Right" Text="Firm" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="Light touch" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="CurveSlider" Minimum="-1" Maximum="1" Value="0" ToolTip="Response curve"/>
                        </DockPanel>
                        <CheckBox x:Name="HitsCheck" Content="Face buttons add hits" IsChecked="True" Margin="0,10,0,2"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="26,0,0,6" Text="✕ punch · □ left thump · ○ right tick · △ swell · L1/R1 light taps"/>
                        <CheckBox x:Name="TrigVibCheck" Content="Also record trigger vibration (triggers buzz under your fingers)"/>
                    </StackPanel>
                </Border>

                <!-- Length -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2 · Loop length" Style="{StaticResource H2}"/>
                        <WrapPanel x:Name="LengthChips">
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="2 s" Tag="2" Checked="OnLengthChip"/>
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="4 s" Tag="4" Checked="OnLengthChip"/>
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="8 s" Tag="8" IsChecked="True" Checked="OnLengthChip"/>
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="15 s" Tag="15" Checked="OnLengthChip"/>
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="30 s" Tag="30" Checked="OnLengthChip"/>
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="60 s" Tag="60" Checked="OnLengthChip"/>
                            <RadioButton GroupName="len" Style="{StaticResource Chip}" Content="Free" Tag="0" Checked="OnLengthChip" x:Name="FreeChip"/>
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Custom" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="LengthText" DockPanel.Dock="Right" Width="56" TextAlignment="Right" Style="{StaticResource Muted}"/>
                            <Slider x:Name="LengthSlider" Minimum="1" Maximum="60" Value="8" ValueChanged="OnLengthSlider"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="Free records until you stop (max 2 min). You can still change the length after recording with Trim and Loop length."/>
                        <CheckBox x:Name="CountInCheck" Content="3-beat count-in (controller clicks, lightbar flashes amber)" IsChecked="True" Margin="0,0,0,4"/>
                        <CheckBox x:Name="OverdubCheck" Content="Overdub: layer the new take on top of the current one"/>
                        <CheckBox x:Name="AutoPlayCheck" Content="Play the take as a loop when recording finishes" IsChecked="True" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Record -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="RecordButton" DockPanel.Dock="Left" Content="●  Record" Style="{StaticResource SolidButton}" Background="{StaticResource RecordBrush}"
                                Padding="26,12" FontSize="15" Click="OnRecord"/>
                        <StackPanel DockPanel.Dock="Right" Width="230" VerticalAlignment="Center">
                            <DockPanel><TextBlock Text="L2" Width="26" Style="{StaticResource Muted}"/><ProgressBar x:Name="L2Meter" Style="{StaticResource Meter}" Foreground="{StaticResource LeftTriggerBrush}"/></DockPanel>
                            <DockPanel Margin="0,6,0,0"><TextBlock Text="R2" Width="26" Style="{StaticResource Muted}"/><ProgressBar x:Name="R2Meter" Style="{StaticResource Meter}" Foreground="{StaticResource RightTriggerBrush}"/></DockPanel>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                            <TextBlock x:Name="StateText" Text="Ready" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StateDetail" Style="{StaticResource Muted}" Text="Press Record, then play the triggers."/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="TakeProgress" Style="{StaticResource Meter}" Height="4" Foreground="{StaticResource RecordBrush}" Margin="0,0,0,8"/>
                    <c:PatternView x:Name="LiveView" Height="120" Editable="False"/>
                </StackPanel>
            </Border>

            <!-- Edit -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="3 · Edit the take" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="NameBox" Width="220" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Pattern name"/>
                            <Button x:Name="SaveButton" Content="Save to My Patterns" Style="{StaticResource SolidButton}" Margin="0" Click="OnSave" IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="NoTakeText" Style="{StaticResource Muted}" Text="No take yet. Record something above and it will appear here for trimming, re-timing and polishing."/>
                    <c:PatternEditor x:Name="Editor" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
