<UserControl x:Class="DualSenseStudio.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DualSenseStudio.Controls">
    <Grid Margin="28,24,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="My Patterns" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Text="Your saved recordings and edited patterns. Changes save automatically. Draw directly on the waveform, or start from a copy of a preset."/>
        </StackPanel>

        <!-- list -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="+ New" Style="{StaticResource GhostButton}" Click="OnNew" ToolTip="New blank 4-second pattern"/>
                    <Button Content="From preset" Style="{StaticResource GhostButton}" Click="OnFromPreset" ToolTip="Copy the currently playing preset (or the first one) into your library"/>
                    <Button Content="Import" Style="{StaticResource GhostButton}" Click="OnImport"/>
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Duplicate" Style="{StaticResource GhostButton}" Click="OnDuplicate"/>
                    <Button Content="Export" Style="{StaticResource GhostButton}" Click="OnExport"/>
                    <Button Content="Delete" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}" Click="OnDelete"/>
                </WrapPanel>
                <Grid>
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="OnSelect"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                        <Run Text="{Binding DurationSeconds, StringFormat={}{0:0.0} s, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="6" VerticalAlignment="Top"
                               Text="Nothing saved yet. Record a take in the Recorder, or press + New."/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- editor -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="SavedText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="NameBox" FontSize="15" VerticalContentAlignment="Center" LostFocus="OnNameCommit" KeyDown="OnNameKey"/>
                    </DockPanel>
                    <TextBlock x:Name="SelectHint" Style="{StaticResource Muted}" Text="Select a pattern on the left to edit it."/>
                    <c:PatternEditor x:Name="Editor"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
