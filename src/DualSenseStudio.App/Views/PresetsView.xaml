<UserControl x:Class="DualSenseStudio.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,16,24">
            <TextBlock Text="Presets" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                       Text="Click a pattern to start it. It loops until you stop it. Adjust intensity, speed and balance in the bar at the bottom. On the controller: D-pad ◀ ▶ changes preset, ▲ ▼ changes intensity, Options plays/stops, Mute stops everything."/>
            <WrapPanel x:Name="Tiles"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
