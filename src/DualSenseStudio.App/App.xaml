<Application x:Class="DualSenseStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette: PlayStation-inspired. PS blue accent on deep navy-black surfaces;
                 channel colours follow the face-button symbols (cross blue, circle red, square pink, triangle teal). -->
            <Color x:Key="AccentColor">#0070D1</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#0070D1"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#330070D1"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#E5364F"/>
            <SolidColorBrush x:Key="RecordBrush" Color="#E5364F"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#1FBF8F"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#F5A524"/>
            <SolidColorBrush x:Key="WindowBrush" Color="#080C16"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="#050810"/>
            <SolidColorBrush x:Key="CardBrush" Color="#0F1626"/>
            <SolidColorBrush x:Key="CardAltBrush" Color="#16203A"/>
            <SolidColorBrush x:Key="StrokeBrush" Color="#1F2C4A"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F3F6FB"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#8A97B5"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#16203A"/>
            <SolidColorBrush x:Key="ChipHoverBrush" Color="#1E2C50"/>
            <SolidColorBrush x:Key="PlotBrush" Color="#0A1120"/>
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0D1528"/>
            <SolidColorBrush x:Key="NavCheckedBrush" Color="#0F2142"/>
            <SolidColorBrush x:Key="TileActiveBrush" Color="#0B2548"/>
            <SolidColorBrush x:Key="MeterTrackBrush" Color="#1C2944"/>
            <SolidColorBrush x:Key="UpdateBannerBrush" Color="#06284F"/>
            <SolidColorBrush x:Key="WarnBannerBrush" Color="#2E2414"/>
            <SolidColorBrush x:Key="CrossBrush" Color="#5B93FF"/>
            <SolidColorBrush x:Key="CircleBrush" Color="#FF4D6A"/>
            <SolidColorBrush x:Key="SquareBrush" Color="#F06EB4"/>
            <SolidColorBrush x:Key="TriangleBrush" Color="#1FC7A6"/>
            <SolidColorBrush x:Key="LeftChannelBrush" Color="#5B93FF"/>
            <SolidColorBrush x:Key="RightChannelBrush" Color="#FF4D6A"/>
            <SolidColorBrush x:Key="LeftTriggerBrush" Color="#F06EB4"/>
            <SolidColorBrush x:Key="RightTriggerBrush" Color="#1FC7A6"/>

            <!-- Make the Fluent controls (sliders, checkboxes, focus) use PS blue instead of the Windows accent -->
            <Color x:Key="{x:Static SystemColors.AccentColorKey}">#0070D1</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#1A86E6</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#2F95F0</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#5AACF5</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#005DB0</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#004A8F</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#003770</Color>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorBrushKey}" Color="#0070D1"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight1BrushKey}" Color="#1A86E6"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight2BrushKey}" Color="#2F95F0"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight3BrushKey}" Color="#5AACF5"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark1BrushKey}" Color="#005DB0"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark2BrushKey}" Color="#004A8F"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark3BrushKey}" Color="#003770"/>

            <!-- Text -->
            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

            <!-- Containers -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Chip toggle (works for ToggleButton and RadioButton) -->
            <Style x:Key="Chip" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar navigation -->
            <Style x:Key="NavButton" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="8,1"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavCheckedBrush}"/>
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Solid buttons -->
            <Style x:Key="SolidButton" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SolidButton}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SolidButton}">
                <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>

            <!-- Preset tile -->
            <Style x:Key="Tile" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                <Setter Property="Width" Value="208"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="active">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileActiveBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Level meter -->
            <Style x:Key="Meter" TargetType="ProgressBar">
                <Setter Property="Height" Value="8"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{StaticResource MeterTrackBrush}" CornerRadius="4"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
